# Do NOT commit the real .env file.
# SQL Server SA Password must meet the password policy (at least 8 chars, uppercase, lowercase, numbers, or symbols).
# This is for local development only.
MSSQL_SA_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=HomeStoreDb;encrypt=true;trustServerCertificate=true
DB_USERNAME=homestore_app
DB_PASSWORD=CHANGE_ME_WITH_A_STRONG_APPLICATION_PASSWORD
